{
  "name": "@kreek/consult",
  "version": "15.3.0",
  "description": "Consult for Pi: Consult skills and runtime extensions in one package.",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "src",
    "extensions",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node ../scripts/generate-plugin-symlinks.mjs",
    "test": "vitest run test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@types/node": "^24.0.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kreek/consult.git",
    "directory": "consult"
  },
  "author": "Alastair Dawson",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "consult",
    "agent-skills",
    "skills",
    "engineering",
    "code-review",
    "proof",
    "contract-first",
    "interface-design"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
